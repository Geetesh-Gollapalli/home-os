<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dial_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_call"
            android:contentDescription="Speed Dial" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Family Speed Dial"
            android:textColor="#1F2024"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dial_app_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home OS"
            android:textColor="#5B5BD6"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#E1E4F2" />

    <!-- 2 Contact Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Contact 1 Card -->
        <LinearLayout
            android:id="@+id/widget_contact_1_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_contact_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact 1"
                android:textColor="#1F2024"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_contact_1_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family"
                android:textColor="#74777F"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_contact_1_btn_call"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_widget_call"
                    android:contentDescription="Call" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_contact_1_btn_wa"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_whatsapp"
                    android:contentDescription="WhatsApp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contact 2 Card -->
        <LinearLayout
            android:id="@+id/widget_contact_2_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_contact_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dad"
                android:textColor="#1F2024"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_contact_2_rel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family"
                android:textColor="#74777F"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_contact_2_btn_call"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_widget_call"
                    android:contentDescription="Call" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_contact_2_btn_wa"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_whatsapp"
                    android:contentDescription="WhatsApp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
